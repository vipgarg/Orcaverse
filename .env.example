# Public URL of the deployed site (used for canonical URLs, sitemap and OG tags)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Contact form delivery (Resend). Without these the form only works in development.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Optional: also POST each enquiry as JSON to a CRM / automation webhook
FORM_WEBHOOK_URL=

# Optional: Cloudflare Turnstile spam protection
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
